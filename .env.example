# Copy to .env (which is gitignored) and fill in.
# The init script FAILS LOUDLY if KC_BOOTSTRAP_ADMIN_PASSWORD is unset. That is deliberate:
# a default password is a hardcoded credential with extra steps (AP-41).

# TideCloak master admin (bootstrap/operator credential — NOT an application user)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Where TideCloak runs
TIDECLOAK_LOCAL_URL=http://localhost:8080

# Where this app runs. Must match the client's registered redirect URIs and web origins.
CLIENT_APP_URL=http://localhost:3000

# Realm / client identity
NEW_REALM_NAME=hospital
CLIENT_NAME=hospital-app

# Contact address used for Tide license activation during setUpTideRealm
TIDE_LICENSE_EMAIL=admin@hospital.example
